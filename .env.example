# ================= Général =================
SITE_NAME=ContexteTech
# Domaine public (HTTPS automatique via Caddy)
DOMAIN=contextetech.com
PUBLIC_ORIGIN=https://contextetech.com
# 0 en développement local sans HTTPS
COOKIE_SECURE=1
# Administrateur créé au premier démarrage
ADMIN_USERNAME=contextetech
ADMIN_PASSWORD=change-moi-10-caracteres-min
# 1 = importer les ressources d'exemple au démarrage
SEED_EXAMPLES=1

# ================= PostgreSQL — Scaleway Managed Database =================
# Console Scaleway > Managed Databases > endpoint public (IP et port)
POSTGRES_HOST=51.x.x.x
POSTGRES_PORT=12345
POSTGRES_DB=contextec
POSTGRES_USER=contextec
POSTGRES_PASSWORD=change-moi
# require | verify-full (avec POSTGRES_SSLROOTCERT=/app/scw-db-ca.pem) | disable (base locale)
POSTGRES_SSLMODE=require
POSTGRES_SSLROOTCERT=
# Base locale de test : POSTGRES_HOST=db, POSTGRES_PORT=5432, POSTGRES_SSLMODE=disable

# ================= Redis =================
REDIS_URL=redis://redis:6379/0

# ================= Scaleway Object Storage (gros datasets, optionnel) =================
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_DATASET_MB=50

# ================= Bac à sable =================
# anthropic | openai (Ollama, vLLM, LM Studio…) | vide = désactivé
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL_QUICK=
LLM_MODEL_DEFAULT=
LLM_MODEL_COMPLEX=
LLM_MAX_TOKENS=1024
SAMPLE_RATE_PER_MIN=10

# ---------- E-mails (SMTP de Proton) : vide = aucun envoi ----------
# Jeton SMTP : Proton > Paramètres > IMAP/SMTP > jetons SMTP, pour coucou@contextetech.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=coucou@contextetech.com
SMTP_PASSWORD=
SMTP_FROM=ContexteTech <coucou@contextetech.com>
MAIL_BCC=coucou@contextetech.com

# ================= Performance =================
API_WORKERS=2

# ================= Mentions légales =================
LEGAL_EDITEUR=
LEGAL_FORME=
LEGAL_ADRESSE=
LEGAL_SIREN=
LEGAL_EMAIL=
LEGAL_DIRECTEUR=
LEGAL_HEBERGEUR=Scaleway SAS, 8 rue de la Ville l'Évêque, 75008 Paris, France
LEGAL_UPDATED=2026-09-25
