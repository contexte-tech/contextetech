---
// Zone administrateur /a3/ (comme /ededed/ sur pmo) — modération : désapprouver une ressource la masque (404, noindex, hors listes) sans la supprimer.
import Base from "../../layouts/Base.astro";
import AlertBadge from "../../components/AlertBadge.astro";
import { KCOLOR } from "../../lib/format.js";
import { translator } from "../../lib/i18n.js";
import { api, noCache, site } from "../../lib/server.js";
import { profilePath, resourcePath } from "../../lib/paths.js";

const lang = "fr";
const t = translator(lang, site().name);
noCache(Astro);
const user = await api(Astro, "/api/auth/me");
if (!user.authenticated) return Astro.redirect("/a2/?next=/a3/");
if (!user.isAdmin) return Astro.redirect("/a2/");
const u = Astro.url.searchParams;
const status = ["all", "visible", "hidden"].includes(u.get("s")) ? u.get("s") : "all";
const q = (u.get("q") || "").slice(0, 80);
// Filtre et tri par niveau d'alerte : ?min=3, ?tri=alerte
const min = Math.max(0, Math.min(5, parseInt(u.get("min") || "0", 10) || 0));
const tri = u.get("tri") === "alerte" ? "alerte" : "date";
const data = await api(Astro, `/api/admin/resources?status=${status}&q=${encodeURIComponent(q)}&min=${min}`);
if (tri === "alerte") data.items.sort((a, b) => b.alert - a.alert);
const here = `/a3/?s=${status}${q ? "&q=" + encodeURIComponent(q) : ""}${min ? "&min=" + min : ""}${tri === "alerte" ? "&tri=alerte" : ""}`;
// Âge court : 17 min, 1 h, 1 j, 3 sem
const age = (ms) => {
  const m = Math.max(0, Math.round((Date.now() - ms) / 60000));
  return m < 60 ? `${m} min` : m < 1440 ? `${Math.round(m / 60)} h` : m < 10080 ? `${Math.round(m / 1440)} j` : `${Math.round(m / 10080)} sem`;
};
const TABS = [["all", t("mod_all"), data.counts.visible + data.counts.hidden], ["visible", t("mod_visible"), data.counts.visible], ["hidden", t("mod_hidden"), data.counts.hidden]];
---
<Base lang={lang} path="/" user={user} title={t("moderation")} noindex={true} admin={true}>
  <div class="moderation">
    <h1 class="h2">{t("moderation")}</h1>
    <nav class="tabs u-mb10" role="tablist">
      <a role="tab" aria-selected="true" href="/a3/">{t("moderation")}</a>
      <a role="tab" aria-selected="false" href="/a3/membres">{t("members")}</a>
      <a role="tab" aria-selected="false" href="/a3/tags">{t("tags_admin")}</a>
    </nav>
    <p class="note">{t("mod_help")}</p>
    <nav class="tabs" role="tablist">
      {TABS.map(([k, label, n]) => <a role="tab" aria-selected={status === k ? "true" : "false"} href={`/a3/?s=${k}`}>{label}{n > 0 && <span class="n"> {n}</span>}</a>)}
    </nav>
    <form method="get" action="/a3/" class="modsearch">
      <input type="hidden" name="s" value={status} />
      {min > 0 && <input type="hidden" name="min" value={min} />}
      <input type="search" name="q" value={q} placeholder={t("mod_search")} aria-label={t("mod_search")} />
    </form>
    <div class="alertfilter"><span class="note">{t("al_filter")}</span>
      {[0, 2, 3, 4, 5].map((n) => <a class={min === n ? "btn sm primary" : "btn sm"} href={`/a3/?s=${status}${n ? "&min=" + n : ""}${tri === "alerte" ? "&tri=alerte" : ""}`}>{n ? "≥ " + n : t("mod_all")}</a>)}
      <a class="btn sm" href={`/a3/?s=${status}${min ? "&min=" + min : ""}${tri === "alerte" ? "" : "&tri=alerte"}`}>{t(tri === "alerte" ? "al_sort_date" : "al_sort")}</a>
    </div>
    {data.items.length === 0 ? <p class="note">{t("no_results")}</p> : (
      <div class="tscroll"><table class="rows modtable">
        <thead><tr><th>{t("al_col")}</th><th>{t("mod_resource")}</th><th>{t("fm_author")}</th><th>{t("mod_date")}</th><th>♥ / ▶ / 💬</th><th></th></tr></thead>
        <tbody>{data.items.map((r) => (
          <tr class={r.hidden ? "is-hidden" : ""}>
            <td><AlertBadge level={r.alert} why={r.why} /></td>
            <td><span class={`type k-${r.kind}`} >{t("o_" + r.kind)}</span> <a href={resourcePath(lang, r.kind, r.id)}>{r.name}</a></td>
            <td><a href={profilePath(lang, r.author)}>{r.author}</a></td>
            <td class="note">{age(r.createdAt)}</td>
            <td class="note">{r.likes} / {r.uses} / {r.comments}</td>
            <td>
              <form method="post" action={`/api/admin/resources/${encodeURIComponent(r.id)}/visibility`}>
                <input type="hidden" name="hidden" value={r.hidden ? "0" : "1"} /><input type="hidden" name="next" value={here} />
                <button class={r.hidden ? "btn sm icon st-hidden" : "btn sm icon st-visible"} type="submit" title={t(r.hidden ? "mod_approve" : "mod_reject")} aria-label={t(r.hidden ? "mod_approve" : "mod_reject")}>{r.hidden ? "✓" : "⊘"}</button>
              </form>
            </td>
          </tr>
        ))}</tbody>
      </table></div>
    )}
  </div>
</Base>
