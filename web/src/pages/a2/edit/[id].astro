---
import Base from "../../../layouts/Base.astro";
import ResourceForm from "../../../components/ResourceForm.svelte";
import { CLANGS } from "../../../lib/format.js";
import { clangName, dict, translator } from "../../../lib/i18n.js";
import { api, noCache, site } from "../../../lib/server.js";

const lang = "fr";
const { id } = Astro.params;
const S = site();
const t = translator(lang, S.name);
noCache(Astro);
const user = await api(Astro, "/api/auth/me");
if (!user.authenticated) return Astro.redirect(`/a2/?next=${encodeURIComponent(Astro.url.pathname)}`);
const it = await api(Astro, `/api/resources/${encodeURIComponent(id)}`);
if (!it) return Astro.rewrite("/404");
// Un membre ne modifie que ses propres ressources
if (it.authorId !== user.id && !user.isAdmin) return Astro.redirect("/a2/");
const [cfg, dsList] = await Promise.all([
  api(Astro, "/api/config"),
  it.kind === "lora" || it.kind === "model" ? api(Astro, "/api/resources?kind=dataset&sort=recent") : Promise.resolve({ items: [] }),
]);
const knownTags = (await api(Astro, `/api/tags?kind=${it.kind}`)).items;
const loras = it.kind === "model" ? (await api(Astro, "/api/resources?kind=lora&sort=recent")).items : [];
const models = ["context", "prompt", "tool"].includes(it.kind) ? (await api(Astro, "/api/resources?kind=model&sort=recent")).items : [];
const listOf = async (kk) => (await api(Astro, `/api/resources?kind=${kk}&sort=recent`)).items;
const [mcps, contexts, evaluables] = it.kind === "harness" ? [await listOf("tool"), [], []]
  : it.kind === "agent" ? [await listOf("tool"), await listOf("context"), []]
  : it.kind === "eval" ? [[], [], await listOf("context,prompt,agent,skill,model,rag")] : [[], [], []];
const clangNames = Object.fromEntries(CLANGS.map((c) => [c, clangName(lang, c)]));
---
<Base lang={lang} path={`/edit/${encodeURIComponent(id)}`} user={user} title={t("t_edit", { k: t("o_" + it.kind) })} noindex={true} admin={true}>
  <ResourceForm client:load kind={it.kind} initial={it} mode="edit" lang={lang} s={dict(lang, S.name)}
    datasets={dsList.items.filter((d) => d.id !== it.id)} cfg={cfg} defaultHandle={user.name} clangNames={clangNames} isAdmin={!!user.isAdmin} knownTags={knownTags} loras={loras} models={models} mcps={mcps} contexts={contexts} evaluables={evaluables} />
</Base>
